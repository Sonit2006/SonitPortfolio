{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "isolatedModules": true, "moduleDetection": "force",
    "strict": true, "noEmit": true, "skipLibCheck": true
  },
  "include": ["src"]
}
